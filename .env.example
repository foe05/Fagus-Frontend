# ── WordPress API ────────────────────────────────────
# Im Docker-Container wird dies automatisch auf die lokale Instanz gesetzt.
# Fuer lokale Entwicklung ohne Docker kann hier eine externe URL gesetzt werden.
WP_API_URL=http://localhost/wp-json/wp/v2

# ── WordPress Site URL ──────────────────────────────
# Die oeffentliche URL der Website (fuer WordPress-interne Links)
WP_URL=http://localhost

# ── WordPress Debug ─────────────────────────────────
# WP_DEBUG=true

# ── E-Mail / SMTP (fuer Kontaktformular) ────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=deine-email@gmail.com
SMTP_PASS=dein-app-passwort
CONTACT_EMAIL=kontakt@broetzens.de

# ── Analytics (optional) ────────────────────────────
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=broetzens.de
