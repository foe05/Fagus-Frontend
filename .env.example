# ── WordPress API ────────────────────────────────────
# Im Docker-Container wird dies automatisch auf die lokale Instanz gesetzt.
# Fuer lokale Entwicklung ohne Docker kann hier eine externe URL gesetzt werden.
WP_API_URL=https://broetzens.de/wp-json/wp/v2

# ── WordPress Site URL ──────────────────────────────
# Die oeffentliche URL der Website (fuer WordPress-interne Links)
WP_URL=https://broetzens.de

# ── WordPress Debug ─────────────────────────────────
# WP_DEBUG=true

# ── E-Mail / Kontaktformular ──────────────────────────
# Contact form submissions are routed through WordPress wp_mail()
# which uses the WP Mail SMTP plugin for delivery.
# Configure SMTP settings in wp-admin > WP Mail SMTP.
# The recipient address is stored as WP option (fagus_contact_email),
# defaulting to hallo@broetzens.de.

# ── Digitale Kontaktkarte (/c/<slug>) ───────────────
# Der Mailversand der Kontaktkarte laeuft ueber denselben Weg wie das
# Kontaktformular: WordPress wp_mail() (mu-plugin fagus/v1/card-mail) -> WP Mail
# SMTP -> Hetzner. Es sind KEINE separaten SMTP-Zugangsdaten in Next.js noetig.
# Dieser Endpoint kann an beliebige Empfaenger senden (Besucher-Bestaetigung)
# und ist daher per gemeinsamem Geheimnis geschuetzt. Einen langen Zufallswert
# erzeugen, z.B.: openssl rand -hex 32
CARD_MAIL_TOKEN=dein-langes-zufalls-geheimnis

# ── Analytics (optional) ────────────────────────────
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=broetzens.de

# ── Zentrales Logging (log.broetzens.de) ────────────
# API-Key fuer den Tool-Logging-Endpoint. Wird vom internen Proxy
# (app/api/log/route.ts) serverseitig als X-Api-Key gesendet — der Key
# verlaesst nie den Server. Wenn leer, wird nichts geloggt (graceful no-op).
LOGGING_API_KEY=dein-logging-api-key

# ── Newsletter / E-Mail-Abonnement ──────────────────
# Waehle einen Anbieter: 'mailchimp' oder 'brevo'
NEWSLETTER_PROVIDER=mailchimp

# Mailchimp-Konfiguration
MAILCHIMP_API_KEY=dein-mailchimp-api-key
MAILCHIMP_AUDIENCE_ID=deine-audience-id
MAILCHIMP_SERVER_PREFIX=us1

# Brevo (Sendinblue) Konfiguration (alternative)
# BREVO_API_KEY=dein-brevo-api-key
# BREVO_LIST_ID=deine-list-id
